# Default environment variables - Safe to commit to version control
# Do NOT add any sensitive API keys here - use .env.local instead

# Public API URLs and non-sensitive configuration
NEXT_PUBLIC_SITE_URL=https://americastapestry.com
NEXT_PUBLIC_DEFAULT_MAPBOX_STYLE=mapbox://styles/mapbox/light-v11

# Default values (will be overridden by .env.local if present)
# Add placeholder/dummy values for sensitive keys, to document what's needed
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=your_mapbox_token_here
RESEND_API_KEY=your_resend_api_key_here
MAILERLITE_API_KEY=your_mailerlite_api_key_here

# Keystatic CMS Configuration
# For local development, no environment variables are required
# For GitHub storage mode (production), you'll need:
# KEYSTATIC_GITHUB_CLIENT_ID=your_github_oauth_app_client_id
# KEYSTATIC_GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret
# KEYSTATIC_SECRET=generate_a_random_secret_here

# Cloudflare R2 Storage (for image hosting)
# Get these from Cloudflare Dashboard > R2 > Manage R2 API Tokens
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_IMAGES_BUCKET=americas-tapestry-images
R2_IMAGES_PUBLIC_URL=https://pub-xxxxx.r2.dev
NEXT_PUBLIC_R2_IMAGES_URL=https://pub-xxxxx.r2.dev

# Shopify Storefront API (headless commerce — America's Tapestry collection)
# Domain is the shared store; token is a Storefront API access token.
NEXT_PUBLIC_SHOPIFY_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your-storefront-api-token
