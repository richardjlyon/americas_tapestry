{
  "name": "americas-tapestry",
  "version": "1.0.0",
  "description": "A visual exploration of cultural diversity across the American landscape",
  "private": true,
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": "24.11"
  },
  "scripts": {
    "dev": "next dev",
    "dev:linux": "chromium --remote-debugging-port=9222 --headless & sleep 2 && next dev",
    "dev:mac": "next dev",
    "build": "node scripts/check-images.mjs && next build",
    "build:clean": "rm -rf .next && node scripts/check-images.mjs && next build",
    "start": "next start",
    "start:clean": "npm run build:clean && npm run start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:images": "node scripts/check-images.mjs",
    "format": "npx @biomejs/biome format --write ./src/app ./src/components ./src/lib ./src/hooks",
    "analyze": "cross-env ANALYZE=true next build",
    "analyze:server": "cross-env BUNDLE_ANALYZE=server next build",
    "analyze:browser": "cross-env BUNDLE_ANALYZE=browser next build",
    "perf": "npm run build && npm run start",
    "test": "NODE_OPTIONS=\"--disable-warning=DEP0040\" jest",
    "test:watch": "NODE_OPTIONS=\"--disable-warning=DEP0040\" jest --watch",
    "test:coverage": "NODE_OPTIONS=\"--disable-warning=DEP0040\" jest --coverage",
    "test:refactor": "npm run test:components && npm run test:e2e",
    "test:components": "NODE_OPTIONS=\"--disable-warning=DEP0040\" jest --testPathPattern=component-integrity",
    "test:e2e": "NODE_OPTIONS=\"--disable-warning=DEP0040\" playwright test refactor-safety.spec.ts",
    "test:quick": "NODE_OPTIONS=\"--disable-warning=DEP0040\" jest --testPathPattern=simple-smoke",
    "test:all": "npm run test:refactor"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.1",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.2",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@vercel/analytics": "^1.5.0",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "graphql": "^16.14.2",
    "graphql-request": "^7.4.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.454.0",
    "mapbox-gl": "^3.10.0",
    "next": "^16.2.12",
    "next-themes": "^0.4.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.54.1",
    "react-map-gl": "^8.0.1",
    "remark": "^15.0.1",
    "remark-html": "^16.0.1",
    "resend": "^4.0.1",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "three": "^0.183.2",
    "zod": "^3.24.1"
  },
  "overrides": {
    "glob": "^10.0.0",
    "mdast-util-to-hast": "^13.2.0",
    "protocol-buffers-schema": "^3.6.1",
    "postcss": "^8.5.23",
    "@eslint/eslintrc": {
      "js-yaml": "^4.1.0"
    }
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.948.0",
    "@biomejs/biome": "1.9.4",
    "@next/bundle-analyzer": "^16.2.12",
    "@playwright/test": "^1.54.1",
    "@tailwindcss/typography": "^0.5.16",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "22.18.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.183.1",
    "cross-env": "^7.0.3",
    "eslint": "^9.22.0",
    "eslint-config-next": "^16.2.12",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.5.23",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.17",
    "ts-jest": "^29.4.0",
    "typescript": "5.9.2"
  }
}
